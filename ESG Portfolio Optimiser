        "def portfolio_volatility(weights, cov_matrix):\n",
        "    return np.sqrt(np.dot(weights.T, np.dot(cov_matrix, weights)))\n",
        "\n",
        "def get_frontier(mean_returns, cov_matrix, n_points=20):\n",
        "    n = len(mean_returns)\n",
        "    target_returns = np.linspace(mean_returns.min(), mean_returns.max(), n_points)\n",
        "    frontier_vol = []\n",
        "\n",
        "    for target in target_returns:\n",
        "        target_constraints = (\n",
        "            {'type': 'eq', 'fun': lambda w: np.sum(w) - 1},\n",
        "            {'type': 'eq', 'fun': lambda w, target=target: np.dot(w, mean_returns) - target}\n",
        "        )\n",
        "        bounds = tuple((0, 1) for _ in range(n))\n",
        "        initial_guess = np.array([1/n] * n)\n",
        "\n",
        "        result = minimize(portfolio_volatility, initial_guess, args=(cov_matrix,),\n",
        "                           method='SLSQP', bounds=bounds, constraints=target_constraints)\n",
        "        frontier_vol.append(result.fun)\n",
        "\n",
        "    return pd.DataFrame({'Return': target_returns, 'Volatility': frontier_vol})\n",
        "\n",
        "frontier_full = get_frontier(mean_returns_full, cov_matrix_full)\n",
        "frontier_screened = get_frontier(mean_returns_screened, cov_matrix_screened)"
