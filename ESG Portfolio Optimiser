      "cell_type": "code",
      "source": [
        "# Shared optimizer rules\n",
        "constraints = ({'type': 'eq', 'fun': lambda w: np.sum(w) - 1})\n",
        "bounds_list = []\n",
        "for i in range(n_full):\n",
        "    bounds_list.append((0, 1))   # each stock's weight must be between 0 and 1\n",
        "bounds_full = tuple(bounds_list)\n",
        "bounds_list_screened = []\n",
        "for i in range(n_screened):\n",
        "    bounds_list_screened.append((0, 1))\n",
        "bounds_screened = tuple(bounds_list_screened)"
