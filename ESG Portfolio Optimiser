    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.optimize import minimize\n",
        "\n",
        "# Full porfolio\n",
        "equal_weight = 1 / n_full     # if you split evenly, each stock gets this weight\n",
        "starting_weights = []\n",
        "for i in range(n_full):\n",
        "    starting_weights.append(equal_weight)\n",
        "initial_guess_full = np.array(starting_weights)\n",
        "\n",
        "# Optimize full portfolio\n",
        "result_full = minimize(neg_sharpe, initial_guess_full,\n",
        "                            args=(mean_returns_full, cov_matrix_full),\n",
        "                            method='SLSQP', bounds=bounds_full, constraints=constraints)\n",
        "\n",
        "print(\"Full porfolio — optimal weights:\")\n",
        "for ticker, weight in zip(tickers, result_full.x):\n",
        "    print(f\"  {ticker}: {weight:.2%}\")\n",
        "print(f\"Full porfolio Sharpe ratio: {-result_full.fun:.3f}\\n\")"
